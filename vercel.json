{
    "builds": [
        {
            "src": "frontend/**",
            "use": "@vercel/static-build"
        },
        {
            "src": "backend/**",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/dist/$1"
        }
    ]
}